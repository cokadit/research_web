# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgres://research:research@localhost:5432/research

GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=

DASHBOARD_PASSWORD=
# At least 32 random characters. Signs the login cookie.
SESSION_SECRET=

# live = real APIs and real crawling. mock = fixtures only, no network, no keys.
LLM_MODE=mock

# Model IDs checked against ai.google.dev on 2026-09-28. Re-check before changing.
LLM_DISCOVERY_MODEL=gemini-3.8-flash
LLM_EXTRACT_MODEL=gemini-3.5-flash-lite
LLM_VISION_MODEL=gemini-3.8-flash
LLM_EMBED_MODEL=gemini-embedding-2
# Must match the vector column. Changing it needs a new migration.
EMBED_DIM=768

# claude-cli (Max plan) or gemini as fallback. No Anthropic API key in this project.
DRAFT_PROVIDER=claude-cli
# On Windows use the full path, e.g. C:\Users\you\.local\bin\claude.exe
CLAUDE_BIN=claude

DAILY_CANDIDATE_TARGET=120
DAILY_REVIEW_QUEUE_SIZE=30
EXPLORATION_SHARE=0.2

PLACES_ENABLED=false
# Text Search Enterprise has 1,000 free requests per month.
PLACES_MONTHLY_CAP=900

# Sent with every request to a lead's site. Include a way to reach you.
CRAWLER_USER_AGENT=AgungAdityaResearchBot/1.0 (+contact: set CRAWLER_USER_AGENT in .env)
SCREENSHOT_DIR=data/screenshots

SEND_ENABLED=false
# Phase 3
PUBLIC_UNSUBSCRIBE_BASE_URL=
